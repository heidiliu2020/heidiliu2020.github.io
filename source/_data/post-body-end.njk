{%- if page.layout == 'post' %}
<div class="post-coffee" style="text-align: center; margin: 40px 0 20px;">
  <p style="margin-bottom: 10px;">覺得文章有幫助的話，歡迎請我喝杯咖啡 ☕</p>
  <a href="https://www.buymeacoffee.com/heidiliu2020" target="_blank" rel="noopener">
    <img src="https://cdn.buymeacoffee.com/buttons/v2/default-blue.png" alt="Buy Me A Coffee" style="height: 60px !important; width: 217px !important;">
  </a>
</div>
{%- endif %}

{%- if page.comments and not page.no_ads %}
{# min-height 預留廣告空間，避免載入時版面位移（CLS） #}
<div class="ad-post-footer" style="margin: 2rem 0; min-height: 280px;">
  <ins class="adsbygoogle"
       style="display:block"
       data-ad-client="ca-pub-4274798044223706"
       data-ad-slot="3472959732"
       data-ad-format="auto"
       data-full-width-responsive="true"></ins>
  <script>
    (adsbygoogle = window.adsbygoogle || []).push({});
  </script>
</div>
{%- endif %}
