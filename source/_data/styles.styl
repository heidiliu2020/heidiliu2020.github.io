// ===== 極簡白底 + GitHub 藍超連結配色 =====

// 全站背景：淺灰柔和（比純白溫暖一點）
body {
  background: #f5f5f5;
}

// 頂端 headband 黑條隱藏
.headband {
  display: none;
}

// 頂部 site-brand 區塊：白底 + 細邊框
.site-brand-container {
  background: #ffffff;
  border-bottom: 1px solid #e5e6e9;
}

.site-meta .brand {
  background: transparent;
}

.site-title, .site-subtitle, .custom-logo-image {
  color: #1a1a1a !important;
}

// 超連結：GitHub blue
.post-body a:not(.exturl):not(.btn),
.post-body .exturl {
  color: #0969da;
  border-bottom-color: rgba(9, 105, 218, 0.3);

  &:hover {
    color: #0550ae;
    border-bottom-color: #0550ae;
  }
}

// 頁尾：與整體背景一致，分隔線左右留白，內容置中
.footer {
  color: #999999;
  background: #f5f5f5;
  border-top: none;
  font-size: 13px;
  font-weight: 400;
  padding: 0;
  margin-top: 60px;
}

.footer-inner {
  max-width: 800px;
  margin: 0 auto;
  padding: 30px 20px 40px;
  border-top: 1px solid #dbdbdb;
  text-align: center;
}

// Copyright 與語系切換水平排列
.footer .copyright {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16px;
  flex-wrap: wrap;
}

// 語系切換按鈕（中 / EN / JA）
.footer .language-links {
  display: inline-flex;
  gap: 8px;
}

.footer .language-link {
  color: #888888;
  border: none;
  padding: 0 4px;
  font-size: 12px;
  letter-spacing: 0.5px;
  text-decoration: none;
  transition: color 0.15s ease;

  &:hover {
    color: #0969da;
  }

  &.is-active {
    color: #1a1a1a;
    font-weight: 600;
  }
}

.footer .theme-link {
  color: #888888;
}

.footer .theme-link:hover {
  color: #0969da;
}

.footer .author {
  color: #555555;
}

// 文章默認展開
.post-toc .nav .nav-child { display: block; }

// 文章目錄字體大小
.post-toc ol {
  font-size: 13px;
}

:root {
  --content-bg-color: #ffffff;
}

// 統一 sidebar social icons 大小與間距（fa 與 fab 字形混用時需要）
.links-of-author-item {
  .fa, .fab {
    font-size: 14px;
    width: 1.28571429em;
    text-align: center;
    margin-right: 4px;
  }
}

// 留言區樣式（參考 huli 部落格）
.comments-section {
  margin-top: 3rem;
  padding-top: 3rem;
  border-top: 1px solid #dbdbdb;
}

.comments-title {
  font-size: 1.5rem;
  font-weight: 300;
  margin: 0 0 1.5rem;
  color: #363636;
}