// 設定背景
body {
  background:url(/images/bg.jpg) 50% 50% fixed no-repeat;
  background-size: cover;
}

// 設定 site-brand 顏色
.site-brand-container {
  background: #232323;
}

// footer 顏色
.footer {
  color: #fff;
  background: rgba(0,0,0,0.2);
  font-weight: 500;
  padding:0;
  margin-top: 40px;
}

.theme-link {
  color: #eee;
}

.theme-link:hover {
  color: #fff;
}

// 文章默認展開
.post-toc .nav .nav-child { display: block; }

// 文章目錄字體大小
.post-toc ol {  
  font-size : 13px;     
} 

:root {
  --content-bg-color: rgba(255,255,255,0.95);
}

// 統一 sidebar social icons 大小與間距（fa 與 fab 字形混用時需要）
.links-of-author-item {
  .fa, .fab {
    font-size: 14px;
    width: 1.28571429em;
    text-align: center;
    margin-right: 4px;
  }
}